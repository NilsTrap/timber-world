# Copy to .env.local and fill in real values from the staging Supabase project.
# .env.local is gitignored.

TEST_SUPABASE_URL=https://YOUR-STAGING-REF.supabase.co
TEST_SUPABASE_ANON_KEY=...
TEST_SUPABASE_SERVICE_ROLE_KEY=...

# Optional
# TEST_ENV=staging
# NEGATIVE_TESTS_FAIL_ON_LEAK=true   # set to true once RLS is in place

# Agent UI-flow fixture (externally provisioned local Supabase only).
# No fallback values are accepted; keep real values in .env.local or the shell.
NILITTO_UI_FLOW_SUPABASE_URL=http://127.0.0.1:54321
NILITTO_UI_FLOW_CONFIRMATION=UIFLOW-LOCAL-ONLY
NILITTO_UI_FLOW_RUN_LABEL=UIFLOW-YYYYMMDD-NN
NILITTO_UI_FLOW_SERVICE_ROLE_KEY=...
NILITTO_UI_FLOW_TEST_PASSWORD=...
